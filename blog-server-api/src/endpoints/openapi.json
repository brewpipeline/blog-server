      "EmptySuccess": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SuccessBody"
              }
            ],
            "properties": {
              "data": {
                "type": "null"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "total",
          "offset",
          "limit"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PostContainer": {
        "type": "object",
        "required": [
          "post"
        ],
        "properties": {
