        "properties": {
          "postId": {
            "type": "integer",
            "format": "int64"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "CommonMinimalAuthor": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 5,
            "maxLength": 30,
            "description": "Alphanumeric characters and underscores."
          },
          "firstName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2,
            "maxLength": 50
          },
          "lastName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2,
            "maxLength": 50
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "maxLength": 255
          }
        }
      },
