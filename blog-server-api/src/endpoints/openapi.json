        "type": "object",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 50
          },
          "mobile": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50
          },
