              {
                "$ref": "#/components/schemas/SuccessBody"
              }
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/PostContainer"
              }
            }
          }
        }
      },
      "PostsSuccess": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
