        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SuccessBody"
              }
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/AuthorContainer"
              }
            }
          }
        }
